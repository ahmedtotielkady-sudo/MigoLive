# Copy this file to .env for local development.
# Never commit real credentials or production secrets.

PORT=3000

# MongoDB Atlas connection string (Atlas replica set is required for wallet transactions).
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/<database>?retryWrites=true&w=majority

# Use a unique random secret of at least 32 characters.
# Generate one with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
