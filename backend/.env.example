# Copy to .env on the server only. Never commit real values.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
OWNER_BOOTSTRAP_CODE=replace-with-a-separate-random-one-time-secret-at-least-32-characters
PORT=3000
CORS_ORIGINS=https://your-production-domain.example
PAYMENT_WALLET_NUMBER=replace-with-your-payment-wallet-number
